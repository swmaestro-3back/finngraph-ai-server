NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=finngraph
NEO4J_REASON_VECTOR_INDEX=belongs_to_reason_embedding

DATABASE_URL=postgresql://your-db-user:your-db-password@localhost:15432/finngraph

BEDROCK_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_HYPOTHESIS_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EVALUATOR_MODEL=us.anthropic.claude-sonnet-4-6
BEDROCK_LIGHT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=finngraph
