NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=finngraph
# BELONGS_TO.reason_embedding 에 걸린 관계 벡터 인덱스 이름 (Neo4j 5.18+)
NEO4J_REASON_VECTOR_INDEX=belongs_to_reason_embedding
# === Postgres (finngraph-etl ETL DB) ===
# 인사이트 기능이 원장(relation_sources)·재무·캐시를 직접 읽는다.
# 로컬은 finngraph-etl 의 `docker compose up -d db` 노출 포트 기준.
DATABASE_URL=postgresql://threeback:12345678@localhost:15432/finngraph

# === Bedrock (인사이트 기능) ===
# 모델 id 는 계정에 활성화된 인퍼런스 프로파일 기준으로 조정한다.
BEDROCK_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_EVALUATOR_MODEL=us.anthropic.claude-sonnet-4-6
# theme 트랙의 reason 벡터 검색용 — finngraph-etl 이 reason_embedding 을 만들 때
# 쓴 모델과 반드시 같아야 한다. 다르면 벡터가 비교 불가능하다.
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
